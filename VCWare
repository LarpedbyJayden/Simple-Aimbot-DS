-- 9. ESP ENGINE — visible-only, never over game HUD
-- ============================================================
local esp_cache = {}

local function destroy_esp(player)
    local data = esp_cache[player]
    if not data then return end
    pcall(function()
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
    end)
    esp_cache[player] = nil
end

local function build_esp(player, character)
    if player == LocalPlayer then return end
    if not character or not character.Parent then return end
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not head or not humanoid or not root then return end
    if humanoid.Health <= 0 then return end

    local existing = esp_cache[player]
    if existing and existing.character == character and existing.highlight and existing.highlight.Parent then
        return
    end
    destroy_esp(player)

    local highlight = Instance.new("Highlight")
    highlight.Name = "_esp"
    highlight.FillColor = Config.ESP.Color
    highlight.FillTransparency = Config.ESP.FillTransparency
    highlight.OutlineColor = Config.ESP.Color
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_esp_bb"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 160, 0, 44)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = false     -- respect world depth, never draw over game HUD
    billboard.Parent = head

    local name_label = Instance.new("TextLabel")
    name_label.Name = "_esp_name"
    name_label.Size = UDim2.new(1, 0, 0.5, 0)
    name_label.BackgroundTransparency = 1
    name_label.Text = Config.ESP.ShowName and player.Name or ""
    name_label.TextColor3 = Config.ESP.Color
    name_label.TextStrokeTransparency = 0
    name_label.TextScaled = true
    name_label.Font = Enum.Font.SourceSansBold
    name_label.Parent = billboard

    local dist_label = Instance.new("TextLabel")
    dist_label.Name = "_esp_dist"
    dist_label.Size = UDim2.new(1, 0, 0.5, 0)
    dist_label.Position = UDim2.new(0, 0, 0.5, 0)
    dist_label.BackgroundTransparency = 1
    dist_label.Text = ""
    dist_label.TextColor3 = Color3.fromRGB(220, 220, 220)
    dist_label.TextStrokeTransparency = 0
    dist_label.TextScaled = true
    dist_label.Parent = billboard

    esp_cache[player] = {
        highlight = highlight,
        billboard = billboard,
        name_label = name_label,
        dist_label = dist_label,
        character = character,
    }
end

local function on_player_added(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function(char)
        if Config.ESP.Enabled then build_esp(player, char) end
    end)
    if player.Character and Config.ESP.Enabled then
        build_esp(player, player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do on_player_added(p) end
Players.PlayerAdded:Connect(on_player_added)
Players.PlayerRemoving:Connect(destroy_esp)

-- visibility raycast: cheap per-player check from camera to target head.
-- ignores both the target's own character and local character so hits on self / on the
-- target itself don't count as occluders.
local vis_params = RaycastParams.new()
vis_params.FilterType = Enum.RaycastFilterType.Exclude

local function is_visible(head_part, target_char)
    local cam_pos = Camera.CFrame.Position
    vis_params.FilterDescendantsInstances = {target_char, LocalPlayer.Character}
    local result = workspace:Raycast(cam_pos, head_part.Position - cam_pos, vis_params)
    return result == nil
end

RunService.Heartbeat:Connect(function()
    for player, data in pairs(esp_cache) do
        local char = data.character
        if not char or not char.Parent then
            destroy_esp(player)
        elseif Config.ESP.Enabled then
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local my_root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root and head and my_root then
                local dist = (root.Position - my_root.Position).Magnitude
                local within = dist <= Config.ESP.MaxDistance
                local visible = true
                if Config.ESP.VisibleOnly and within then
                    visible = is_visible(head, char)
                end
                local show = within and visible
                data.highlight.Enabled = show
                data.billboard.Enabled = show
                if show then
                    if data.name_label then
                        data.name_label.Text = Config.ESP.ShowName and player.Name or ""
                    end
                    if data.dist_label then
                        data.dist_label.Text = Config.ESP.ShowDistance
                            and string.format("%d studs", math.floor(dist)) or ""
                    end
                end
            end
        else
            data.highlight.Enabled = false
            data.billboard.Enabled = false
        end
    end
end)

-- 5. AIM ORIGIN — mouse on desktop, viewport center on mobile
-- ============================================================
-- the FOV radius is measured from this point. the FOV circle is drawn here.
-- on mobile, GetMouseLocation() lags behind last touch and isn't a cursor — center
-- is where the player's aim actually sits.

local function get_aim_origin()
    if IS_MOBILE then
        return Camera.ViewportSize / 2
    end
    return UserInputService:GetMouseLocation()
end


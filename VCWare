-- ============================================================
-- fill with PlaceIds to restrict to those games. empty = load in any game.
-- to find a PlaceId: run `print(game.PlaceId)` in the executor console.

local ALLOWED_PLACE_IDS = {
    -- 1234567890,
    -- 9876543210,
}

if #ALLOWED_PLACE_IDS > 0 then
    local match = false
    for _, id in ipairs(ALLOWED_PLACE_IDS) do
        if game.PlaceId == id then match = true; break end
    end

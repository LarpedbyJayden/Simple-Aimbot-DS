local function is_same_team(player)
    if player == LocalPlayer then return true end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return true
    end
    local their_color = player.TeamColor
    local my_color = LocalPlayer.TeamColor
    if their_color and my_color and their_color ~= BrickColor.new("Medium stone grey")
       and their_color == my_color then
        return true
    end
    return false
end

local function is_wall_clear(from_pos, to_pos, ignore_char)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {ignore_char, LocalPlayer.Character}
    return workspace:Raycast(from_pos, to_pos - from_pos, params) == nil
end

local function get_nearest_target()
    local my_char = LocalPlayer.Character
    if not my_char then return nil end
    local my_root = my_char:FindFirstChild("HumanoidRootPart")
    local my_head = my_char:FindFirstChild("Head")
    if not my_root or not my_head then return nil end
    local origin = get_aim_origin()
    local best_player, best_dist = nil, math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        if Config.Aimbot.TeamCheck and is_same_

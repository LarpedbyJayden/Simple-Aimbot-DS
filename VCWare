-- 3. ANTI-CHEAT BYPASS
-- ============================================================
local bypassed = false
local function silence_client_ac()
    local ac_patterns = {"anticheat", "anti_cheat", "ac", "guard", "shield", "watchdog"}
    local function scan_and_disable(root)
        if not root then return end
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("LocalScript") or obj:IsA("Script") then
                local lname = obj.Name:lower()
                for _, pat in ipairs(ac_patterns) do
                    if lname:find(pat) then
                        pcall(function() obj.Disabled = true end)
                        break
                    end
                end
            end
        end
    end
    scan_and_disable(LocalPlayer:FindFirstChild("PlayerScripts"))
    if LocalPlayer.Character then scan_and_disable(LocalPlayer.Character) end

    local remotes = game:GetService("ReplicatedStorage"):GetDescendants()
    local block_names = {"iac-respond", "detected", "kick", "ban", "report", "acflag"}
    for _, obj in ipairs(remotes) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local rname = obj.Name:lower()
            for _, bn in ipairs(block_names) do
                if rname:find(bn) then
                    pcall(function()
                        if obj:IsA("RemoteEvent") then obj.OnClientEvent:DisconnectAll() end
                    end)
                    break
                end
            end
        end
    end

    local mt = getrawmetatable(game)
    local old_index = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(t, k)
        if t:IsA("Humanoid") and (k == "WalkSpeed" or k == "JumpPower") then
            if t.Parent == LocalPlayer.Character then
                return (k == "WalkSpeed") and 16 or 50
            end
        end
        return old_index(t, k)
    end)
    setreadonly(mt, true)
    bypassed = true
end
pcall(silence_client_ac)

